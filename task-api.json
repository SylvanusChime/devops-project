{
  "uid": "task-api-overview",
  "title": "task-api / service overview",
  "description": "Five signals chosen to answer three on-call questions: how much traffic and how much of it is failing, how slow business requests are at P50/P95/P99, and what state the task set is in. Latency panels exclude /healthz and /metrics by construction; see deploy/NOTES.md.",
  "tags": ["task-api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "task-api-prom" },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route and code",
      "description": "Business traffic volume, split by response code so a shift from 200 to 4xx/5xx is visible without a second panel.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "task-api-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "task-api-prom" },
          "expr": "sum by (route, code) (rate(http_requests_total{route!=\"/metrics\",route!=\"/healthz\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error ratio (4xx / 5xx as a share of business requests)",
      "description": "Ratio rather than raw count: an absolute error count rises with traffic and cannot be alerted on with a fixed threshold. 5xx is the paging signal; 4xx is separated because it usually means a client bug, not a service failure. The 'or vector(0)' keeps the line at zero instead of leaving a gap when no errors have occurred, which otherwise reads as missing data.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "task-api-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "task-api-prom" },
          "expr": "(sum(rate(http_requests_total{route!=\"/metrics\",route!=\"/healthz\",code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_requests_total{route!=\"/metrics\",route!=\"/healthz\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "5xx ratio"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "task-api-prom" },
          "expr": "(sum(rate(http_requests_total{route!=\"/metrics\",route!=\"/healthz\",code=~\"4..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_requests_total{route!=\"/metrics\",route!=\"/healthz\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "4xx ratio"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Business request latency P50 / P95 / P99",
      "description": "Percentiles are computed from the histogram, aggregated by (le) BEFORE histogram_quantile -- taking the quantile per series and then averaging is a common and silently wrong pattern. Health checks are absent from this histogram at the application level, so they cannot dilute these numbers.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "task-api-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "task-api-prom" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "task-api-prom" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "task-api-prom" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Task state",
      "description": "Answers 'what is the current task state?'. Collected from the store at scrape time, so it cannot drift away from reality the way an incrementing counter can.",
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "task-api-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "task-api-prom" },
          "expr": "sum by (status) (tasks_current)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Bucket coverage below 100µs",
      "description": "Guard rail for the latency panel, not a service metric. If this reaches 1.0 every observation sits in the first histogram bucket and P95/P99 are interpolation artefacts inside [0, 0.0001] rather than measurements. This panel is why the buckets in metrics.go start at 100µs; see the investigation in deploy/NOTES.md.",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "task-api-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "red", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "task-api-prom" },
          "expr": "sum(rate(http_request_duration_seconds_bucket{le=\"0.0001\"}[$__rate_interval])) / clamp_min(sum(rate(http_request_duration_seconds_count[$__rate_interval])), 0.0001)",
          "legendFormat": "fraction in first bucket"
        }
      ]
    }
  ]
}
